#!/bin/sh

crrun=$1
crid=$2
NAME=znetcontrol
DEBUG=0

RULE_SECTION="device"
LOG_FILE="/var/log/$NAME.log"
CONFIG_FILE="/etc/config/$NAME"
IDLIST="/var/run/$NAME.idlist"
TMPID="/var/run/$NAME.tmpid"

# 网关模式变量
GATEWAY_MODE=""
BYPASS_GATEWAY=""
BYPASS_GATEWAY_MAC=""

# 工具检查
bin_nft=$(which nft 2>/dev/null)
bin_iptables=$(which iptables 2>/dev/null)
bin_ip6tables=$(which ip6tables 2>/dev/null)
bin_conntrack=$(which conntrack 2>/dev/null)

# ================= 2.3.11 新增：nft 执行与校验 =================
# 历史问题：nft add element 全部带 2>/dev/null，MAC 被 cut 截断成 "00"
# 后 nft 拒绝该元素，错误被吞，日志却照常打印"已添加"，导致
# "日志说生效、集合为空、设备照样上网"。此后一律留痕。

nft_run() {
    # $@ = nft 参数；失败写日志并返回非 0
    _out=$(nft "$@" 2>&1)
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        case "$_out" in
            *"File exists"*) return 0 ;;   # 元素已存在，视为成功（幂等）
        esac
        log "WARN: nft $* 失败(rc=$_rc): $_out"
        return "$_rc"
    fi
    return 0
}

is_valid_mac() {
    # 【2.3.11-fix】必须大小写都认：uci 里存的是大写 MAC（00:BB:1C:...），
    # 而上一版校验只匹配小写，导致所有规则被拒绝写入 nft（实测复现）。
    _m=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    echo "$_m" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || return 1
    # 排除全零：00:00:00:00:00:00 是无效/广播地址，写进集合会误伤
    case "$_m" in
        00:00:00:00:00:00) return 1 ;;
    esac
    return 0
}

is_valid_ipv4() {
    echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    # 排除全零/空值兜底（历史上 "00" 会被 nft 零填充成 00:00:00:00:00:00）
    case "$1" in
        0.0.0.0) return 1 ;;
    esac
    for _o in $(echo "$1" | tr '.' ' '); do
        [ "$_o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

# 获取规则名称的辅助函数
get_rule_display_name() {
    id=$1
    name=$(config_t_get device name "$id")
    target=$(config_t_get device target "$id")
    
    if [ -z "$name" ] || [ "$name" = "新规则" ]; then
        if [ -n "$target" ]; then
            name="$target"
        else
            name="规则$id"
        fi
    fi
    
    echo "$name"
}

config_get_type() {
    ret=$(uci -q get "${NAME}.${1}")
    if [ -z "$ret" ]; then ret="$2"; fi
    echo "$ret"
}

config_n_get() {
    ret=$(uci -q get "${NAME}.${1}.${2}")
    if [ -z "$ret" ]; then ret="$3"; fi
    echo "$ret"
}

config_t_get() {
    index=$3
    default=$4
    ret=$(uci -q get "${NAME}.@${1}[${index}].${2}")
    echo "${ret:-$default}"
}

# 读取 settings 命名段（非索引段）
config_s_get() {
    ret=$(uci -q get "${NAME}.settings.${1}")
    echo "${ret:-$2}"
}

config_t_set() {
    index=$4
    ret=$(uci -q set "${NAME}.@${1}[${index}].${2}=${3}")
}

list_type="blacklist"

is_input_chain() {
    [ "$CHAIN" = "input" ]
}

log() {
    d="$(date '+%Y-%m-%d %H:%M:%S')"
    echo "[$d] $@" >>$LOG_FILE
}

info() {
    log "INFO: $@"
}

dbg() {
    [ "$DEBUG" -eq 1 ] && log "DEBUG: $@"
}

parse_target() {
    target="$1"
    
    target=$(echo "${target}" | xargs)
    
    # 单个IP地址
    if echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        for octet in $(echo "$target" | tr '.' ' '); do
            [ "$octet" -le 255 ] || return 1
        done
        echo "ipv4"; echo "single"; echo "${target}"
        return 0
    
    # IP范围
    elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}-([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        start_ip=${target%-*}
        end_ip=${target#*-}
        for octet in $(echo "$start_ip" | tr '.' ' '); do
            [ "$octet" -le 255 ] || return 1
        done
        for octet in $(echo "$end_ip" | tr '.' ' '); do
            [ "$octet" -le 255 ] || return 1
        done
        echo "ipv4"; echo "range"; echo "${target}"
        return 0
    
    # CIDR格式
    elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'; then
        ip_part=${target%/*}
        mask=${target#*/}
        if [ "$mask" -ge 0 ] && [ "$mask" -le 32 ]; then
            for octet in $(echo "$ip_part" | tr '.' ' '); do
                [ "$octet" -le 255 ] || return 1
            done
            echo "ipv4"; echo "cidr"; echo "${target}"
            return 0
        fi
    
    # MAC地址
    elif echo "$target" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; then
        echo "mac"; echo "single"; echo "$target" | tr '[:upper:]' '[:lower:]'
        return 0
    
    # IPv6地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$'; then
        echo "ipv6"; echo "single"; echo "${target}"
        return 0
    
    # IPv6 CIDR
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/[0-9]{1,3}$'; then
    ipv6=${target%/*}
    mask=${target#*/}
        if [ "$mask" -ge 0 ] && [ "$mask" -le 128 ]; then
            echo "ipv6"; echo "cidr"; echo "${target}"
            return 0
        fi
    fi
    
    return 1
}

convert_to_old_format() {
    target="$1"
    parsed_result=$(parse_target "$target")
    [ $? -ne 0 ] && return 1
    
    type=$(echo "$parsed_result" | sed -n '1p')
    subtype=$(echo "$parsed_result" | sed -n '2p')
    value=$(echo "$parsed_result" | sed -n '3p')
    
    case "$type" in
        "ipv4")
            case "$subtype" in
                "single") 
                    echo "ip ipv4_addr $value"
                    ;;
                "range")
    start_ip=${value%-*}
    end_ip=${value#*-}
                    echo "ip ipv4_addr { $start_ip-$end_ip }"
                    ;;
                "cidr")
                    echo "ip ipv4_addr $value"
                    ;;
            esac
            ;;
        "mac")
            echo "bridge ether_addr $value"
            ;;
        "ipv6")
            case "$subtype" in
                "single") echo "ip6 ipv6_addr $value" ;;
                "cidr") echo "ip6 ipv6_addr $value" ;;
            esac
            ;;
    esac
}

flush_connections() {
    target="$1"
    
    if [ -x "$bin_conntrack" ]; then
    parsed_result=$(parse_target "${target}")
        if [ $? -eq 0 ]; then
            type=$(echo "$parsed_result" | sed -n '1p')
    subtype=$(echo "$parsed_result" | sed -n '2p')
    value=$(echo "$parsed_result" | sed -n '3p')
            
            case "${type}" in
                "ipv4")
                    case "$subtype" in
                        "single")
                            $bin_conntrack -D -s "${value}" 2>/dev/null || true
                            $bin_conntrack -D -d "${value}" 2>/dev/null || true
                            dbg "清理IP连接: ${value}"
                            ;;
                        "cidr")
                            $bin_conntrack -D -s "${value}" 2>/dev/null || true
                            $bin_conntrack -D -d "${value}" 2>/dev/null || true
                            dbg "清理CIDR连接: ${value}"
                            ;;
                    esac
                    info "断开连接: ${target}"
                    ;;
                "mac")
                    if [ -f "/proc/net/arp" ]; then
    ip_addr=$(grep -i "${value}" /proc/net/arp 2>/dev/null | awk '{print $1}' | head -1)
                        if [ -n "${ip_addr}" ]; then
                            $bin_conntrack -D -s "${ip_addr}" 2>/dev/null || true
                            $bin_conntrack -D -d "${ip_addr}" 2>/dev/null || true
                            dbg "清理MAC连接: ${value} (IP: ${ip_addr})"
                            info "断开MAC连接: ${value}"
                        fi
                    fi
                    ;;
            esac
        else
            dbg "无法解析目标地址: ${target}"
        fi
    else
        dbg "conntrack未安装"
    fi
}

get_enabled_rule_ids() {
    rule_ids=""
    index=0
    
    while true; do
    enable_val=$(uci -q get znetcontrol.@device[$index].enable)
    target_val=$(uci -q get znetcontrol.@device[$index].target)
        
        if [ -z "$enable_val" ] && [ -z "$target_val" ]; then
            break
        fi
        
        if [ "$enable_val" = "1" ] && [ -n "$target_val" ]; then
            rule_ids="$rule_ids $index"
        fi
        
        index=$((index + 1))
    done
    
    if [ -z "$rule_ids" ]; then
        index=0
        while true; do
    enable_val=$(uci -q get znetcontrol.@rule[$index].enabled)
    target_val=$(uci -q get znetcontrol.@rule[$index].target)
            
            if [ -z "$enable_val" ] && [ -z "$target_val" ]; then
                break
            fi
            
            if [ "$enable_val" = "1" ] && [ -n "$target_val" ]; then
                rule_ids="$rule_ids $index"
            fi
            
            index=$((index + 1))
        done
    fi
    
    echo $rule_ids
}

get_device_ip() {
    mac="$1"
    ip=""
    
    mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]' | sed -e 's/-/:/g' -e 's/ //g')
    
    if [ -f "/proc/net/arp" ]; then
        ip=$(cat /proc/net/arp 2>/dev/null | awk -v search_mac="$mac" '
            tolower($4) == search_mac && $3 == "0x2" {print $1; exit}
        ')
    fi
    
    if [ -z "$ip" ]; then
        # dnsmasq 租约文件里 MAC 是冒号分隔；这里同时兼容短横线写法
        ip=$(cat /tmp/dhcp.leases 2>/dev/null | awk -v search_mac="$mac" '
            tolower($2) == search_mac {print $3; exit}
        ')
        if [ -z "$ip" ]; then
    mac_dash=$(echo "$mac" | tr ':' '-')
            ip=$(cat /tmp/dhcp.leases 2>/dev/null | awk -v search_mac="$mac_dash" '
                tolower($2) == search_mac {print $3; exit}
            ')
        fi
    fi
    
    if [ -z "$ip" ]; then
        ip=$(conntrack -L 2>/dev/null | grep -i "$(echo $mac | tr ':' ' ')" | head -1 | awk '{print $5}' | cut -d= -f2)
    fi
    
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    else
        return 1
    fi
}

check_time() {
    start="$1"
    end="$2"
    current=; start_min=; end_min=; current_min=
    
    current=$(date +%H%M)
    # Unified awk: strips any colons, then extracts HH and MM (works for HH:MM and HHMM)
    start_min=$(echo "$start" | awk '{gsub(/:/,""); print substr($0,1,2)*60+substr($0,3,2)}')
    end_min=$(echo "$end" | awk '{gsub(/:/,""); print substr($0,1,2)*60+substr($0,3,2)}')
    current_min=$(echo "$current" | awk '{print substr($0,1,2)*60+substr($0,3,2)}')
    
    if [ "$start_min" -lt "$end_min" ]; then
        [ "$current_min" -ge "$start_min" ] && [ "$current_min" -lt "$end_min" ]
    else
        [ "$current_min" -ge "$start_min" ] || [ "$current_min" -lt "$end_min" ]
    fi
}


expand_week_pattern() {
    input="$1"
    result=""
    first=1

    [ -z "$input" ] && return

    # Replace commas with spaces, then parse word by word (POSIX, ash compatible)
    parts=$(echo "$input" | tr ',' ' ')

    for part in $parts; do
        part=$(echo "$part" | tr -d ' ')
        [ -z "$part" ] && continue

        # Range format: 1-4
        if echo "$part" | grep -qE '^[0-9]+-[0-9]+$'; then
    start=$(echo "$part" | cut -d'-' -f1)
    end=$(echo "$part" | cut -d'-' -f2)
            if [ -n "$start" ] && [ -n "$end" ] && [ "$start" -ge 1 ] && [ "$end" -le 7 ] && [ "$start" -le "$end" ]; then
    i=$start
                while [ $i -le "$end" ]; do
                    if [ $first -eq 1 ]; then
                        result="$i"
                        first=0
                    else
                        result="$result|$i"
                    fi
                    i=$((i + 1))
                done
            fi
        else
            # Single/comma format: 4 or 4,5,6
            if [ $first -eq 1 ]; then
                result="$part"
                first=0
            else
                result="$result|$part"
            fi
        fi
    done

    echo "$result"
}

check_list() {
    i=$1
    start_time=$(config_t_get device timestart "$i")
    end_time=$(config_t_get device timeend "$i")
    wweek=$(config_t_get device week "$i")
    current_weekday=$(date +%u)
    
    if [ "$wweek" != "0" ]; then
    week_pattern=$(expand_week_pattern "$wweek")
        # 【2.3.11 修复】原文案的 bug：
        #   awk 'BEGIN{... if(a[k]==$0) exit 1}' —— BEGIN 阶段 $0 是空串，
        #   比较恒为假，awk 永远 exit 0；外层再套 if !，于是"星期永不匹配失败"
        #   = 任何星期都通过。表现为 start 把所有段都加入、ctrl 按自己的
        #   逻辑又把不生效段删掉（del 按 MAC 值删元素，连带删掉生效段）。
        # 修法：awk 直接 print 匹配结果(0=匹配/1=不匹配)，shell 侧判断，
        #       不依赖 exit 码与 if ! 的取反语义（那是本次踩坑的根源）。
        _wk_hit=$(echo "$current_weekday" | awk -v p="$week_pattern" -v c="$current_weekday" 'BEGIN{n=split(p,a,"|"); r=1; for(k=1;k<=n;k++) if(a[k]==c){r=0; break}; print r}')
        _wk_hit=${_wk_hit:-1}
        if [ "$_wk_hit" -ne 0 ]; then
            dbg "规则 $i 不在生效星期内（配置: $wweek, 当前: $current_weekday）"
            return 1
        fi
    fi
    
    if [ -z "$start_time" ] && [ -z "$end_time" ]; then
        dbg "规则 $i 全天生效"
        return 0
    fi
    
    start_time=${start_time:-"00:00"}
    end_time=${end_time:-"23:59"}
    
    if ! check_time "$start_time" "$end_time"; then
        dbg "规则 $i 不在生效时间内（$start_time - $end_time）"
        return 1
    fi
    
    dbg "规则 $i 在生效时间内"
    return 0
}

detect_gateway_mode() {
    default_gw=$(ip route show default 2>/dev/null | head -1 | awk '{print $3}')
    default_dev=$(ip route show default 2>/dev/null | head -1 | awk '{print $5}')
    lan_iface=$(uci get network.lan.ifname 2>/dev/null || echo "br-lan")
    my_lan_ip=$(ip -4 addr show dev "$lan_iface" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1 | head -1)
    
    # 修复：按默认路由的出口接口判断，不按 IP 对比
    # 如果默认路由走的是 WAN 口（不是 LAN 接口），说明是主路由
    if [ -n "$default_dev" ] && [ "$default_dev" != "$lan_iface" ]; then
        GATEWAY_MODE="main"
        info "检测为主路由模式（默认路由经 $default_dev，LAN: $lan_iface）"
    elif [ -z "$default_gw" ] || [ "$default_gw" = "0.0.0.0" ]; then
        GATEWAY_MODE="main"
        info "检测为主路由模式（无上游网关）"
    else
        GATEWAY_MODE="bypass"
        BYPASS_GATEWAY="$default_gw"
        BYPASS_GATEWAY_MAC=$(arp -n "$default_gw" 2>/dev/null | awk '{print $3}' | grep -v "HWaddress")
        info "检测为旁路由模式，网关: $default_gw（经 $default_dev）"
    fi
}

# 判断字符串是否为 MAC 地址
is_mac_addr() {
    echo "$1" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

# 读取 nft 集合中的元素
set_elements() {
    nft list set inet znetcontrol "$1" 2>/dev/null |         sed -n 's/^[[:space:]]*elements = { \(.*\) }$/\1/p' | tr ',' ' '
}

# 解析 MAC 对应的终端 IP（IPv4 + IPv6）
# 来源优先级：DHCP 租约 > ARP 表（仅有效条目）> IPv6 邻居表
get_device_ips() {
    mac="$1"
    lower=$(echo "$mac" | tr '[:upper:]' '[:lower:]')
    dash=$(echo "$lower" | tr ':' '-')
    out=""
    
    out="$out $(cat /tmp/dhcp.leases 2>/dev/null | awk -v m="$lower" 'tolower($2)==m {print $3}')"
    out="$out $(cat /tmp/dhcp.leases 2>/dev/null | awk -v m="$dash" 'tolower($2)==m {print $3}')"
    out="$out $(cat /proc/net/arp 2>/dev/null | awk -v m="$lower" 'tolower($4)==m && $3=="0x2" {print $1}')"
    out="$out $(ip -6 neigh show 2>/dev/null | awk -v m="$lower" '{for(i=1;i<=NF;i++) if(tolower($i)==m){print $1; break}}')"
    
    echo "$out" | tr ' ' '
' |         grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$|^[0-9a-fA-F]*:[0-9a-fA-F:]+$' |         sort -u | tr '
' ' '
}

# 同步"由 MAC 规则派生出的终端 IP"到 nft 集合（源 IP 双保险）
# 目的：终端即使更换/伪装源 MAC，只要 IP 没变仍会被拦截
sync_mac_ip_sets() {
    [ -n "$bin_nft" ] || return
    desired=""
    idx=0
    while true; do
    en=$(uci -q get "znetcontrol.@device[$idx].enable")
    tg=$(uci -q get "znetcontrol.@device[$idx].target")
        [ -z "$en" ] && [ -z "$tg" ] && break
        if [ "$en" = "1" ] && is_mac_addr "$tg" && check_list "$idx"; then
    mac=$(echo "$tg" | tr '[:upper:]' '[:lower:]')
            desired="$desired $(get_device_ips "$mac")"
        fi
        idx=$((idx + 1))
    done
    cur_v4=$(set_elements ip_mac)
    cur_v6=$(set_elements ip6_mac)
    
    for ip in $cur_v4; do
        case " $desired " in
            *" $ip "*) ;;
            *) nft_run delete element inet znetcontrol ip_mac "{ $ip }" ;;
        esac
    done
    for ip in $cur_v6; do
        case " $desired " in
            *" $ip "*) ;;
            *) nft_run delete element inet znetcontrol ip6_mac "{ $ip }" ;;
        esac
    done
    
    for ip in $desired; do
        case "$ip" in
            *:*)
                case " $cur_v6 " in
                    *" $ip "*) ;;
                    *) nft_run add element inet znetcontrol ip6_mac "{ $ip }" ;;
                esac
                ;;
            *)
                case " $cur_v4 " in
                    *" $ip "*) ;;
                    *) nft_run add element inet znetcontrol ip_mac "{ $ip }" ;;
                esac
                ;;
        esac
    done
    
    dbg "同步派生IP完成: $desired"
}

init_main_route() {
    info "初始化主路由模式"
    
    if [ -n "$bin_nft" ]; then
        nft delete table inet znetcontrol 2>/dev/null || true
        nft delete table ip znetcontrol 2>/dev/null || true
        nft delete table ip6 znetcontrol 2>/dev/null || true
        nft delete table bridge znetcontrol 2>/dev/null || true
        
        # ==========================================================
        # 主路由模式统一使用 inet 家族（一次覆盖 IPv4 + IPv6）
        #
        # 【关键修复】历史版本把 MAC 规则写进 bridge 家族。bridge 家族
        # 的 forward/input 钩子只能看到"同一个网桥内部的二层转发"和
        # "送交本机的帧"，根本看不到"路由转发去 WAN"的流量，所以两种
        # 模式都拦不住上网；而 input 钩子又会把 ARP/DHCP 一起丢掉，
        # 导致被控终端在所有统计页面里彻底消失。
        #
        # 现在的语义：
        #   forward 钩子 = 出网路径（普通 / 强力 两种模式都拦）
        #   input  钩子  = 访问路由器本机（仅强力模式拦；放行 DHCP，
        #                   保证终端能续租、保持在统计页面可见）
        # ==========================================================
        nft_run add table inet znetcontrol || log "ERROR: 创建表 inet znetcontrol 失败"
        # MAC 集合
        nft_run add set inet znetcontrol mac_forward "{ type ether_addr; flags interval; }" || log "ERROR: 创建集合 mac_forward 失败"
        nft_run add set inet znetcontrol mac_input "{ type ether_addr; flags interval; }" || log "ERROR: 创建集合 mac_input 失败"
        # IP 集合：ip_forward/ip_input 来自"按 IP 管控"的规则
        nft add set inet znetcontrol ip_forward "{ type ipv4_addr; flags interval; }" 2>/dev/null || true
        nft add set inet znetcontrol ip_input "{ type ipv4_addr; flags interval; }" 2>/dev/null || true
        nft add set inet znetcontrol ip6_forward "{ type ipv6_addr; flags interval; }" 2>/dev/null || true
        nft add set inet znetcontrol ip6_input "{ type ipv6_addr; flags interval; }" 2>/dev/null || true
        # IP 双保险集合：由 MAC 规则实时解析出的终端 IP 单独存放，
        # 便于精确回收，不会误删"按 IP 管控"规则写入的地址
        nft add set inet znetcontrol ip_mac "{ type ipv4_addr; flags interval; }" 2>/dev/null || true
        nft add set inet znetcontrol ip6_mac "{ type ipv6_addr; flags interval; }" 2>/dev/null || true
        
        nft_run add chain inet znetcontrol forward "{ type filter hook forward priority -100; policy accept; }" || log "ERROR: 创建 forward 链失败"
        # ether saddr 匹配同时覆盖 IPv4 / IPv6
        # 兼容集合规则：旧版把 MAC 塞进 mac_forward/mac_input 共享集合。
        # 新版每段独立 rule（comment=znc-r<id>-fwd/in），集合规则保留
        # 作为"手工/旧配置残留"的兜底，不影响多段并行。
        nft_run add rule inet znetcontrol forward ether saddr @mac_forward drop counter comment "block-mac-forward" || log "ERROR: 保底规则 block-mac-forward 创建失败"
        nft_run add rule inet znetcontrol forward ip saddr @ip_forward drop comment "block-ipv4-forward"
        nft_run add rule inet znetcontrol forward ip saddr @ip_mac drop comment "block-ipv4-mac-derived"
        nft_run add rule inet znetcontrol forward ip6 saddr @ip6_forward drop comment "block-ipv6-forward"
        nft_run add rule inet znetcontrol forward ip6 saddr @ip6_mac drop comment "block-ipv6-mac-derived"
        
        nft_run add chain inet znetcontrol input "{ type filter hook input priority -100; policy accept; }" || log "ERROR: 创建 input 链失败"
        # 强力控制默认放行 DHCP：让终端能续租、保持在概览/统计页面里可见
        # 需要"连路由器也彻底断掉"时，把 strong_allow_dhcp 设为 0
        if [ "$(config_s_get strong_allow_dhcp '1')" = "1" ]; then
            nft_run add rule inet znetcontrol input ether saddr @mac_input udp dport 67 accept comment "allow-dhcp"
            nft_run add rule inet znetcontrol input ip saddr @ip_input udp dport 67 accept comment "allow-dhcp"
        fi
        nft_run add rule inet znetcontrol input ether saddr @mac_input drop counter comment "block-mac-input" || log "ERROR: 保底规则 block-mac-input 创建失败"
        nft_run add rule inet znetcontrol input ip saddr @ip_input drop comment "block-ipv4-input"
        nft_run add rule inet znetcontrol input ip6 saddr @ip6_input drop comment "block-ipv6-input"
        
        # ==========================================================
        # 可选：网关钉扎（pin_gateway=1）
        #
        # 被控终端若把"网关"改成同网段其它设备（如 AP 的管理 IP），
        # 其下一跳就从路由器变成了别的二层邻居。钉扎后，被控终端
        # 只能把帧发给路由器自己的 MAC（或广播/组播），不允许
        # 把下一跳换成别的设备，从而堵住"改网关绕过管控"的路子。
        #
        # 注意：bridge 家族的 forward 钩子只在流量"经由 immortalwrt
        # 的网桥转发"时才可见；同网段内直连的帧（如 终端→AP）在
        # immortalwrt 上看不到，此时需要从 AP 侧关闭其路由/NAT 功能。
        # ==========================================================
        nft delete table bridge znetcontrol_pin 2>/dev/null || true
        if [ "$(config_s_get pin_gateway '0')" = "1" ]; then
    lan_mac=$(ip -o link show br-lan 2>/dev/null | awk -F'link/ether ' '{print $2}' | cut -d' ' -f1)
            if [ -n "$lan_mac" ]; then
                nft add table bridge znetcontrol_pin
                nft add set bridge znetcontrol_pin mac_ctl "{ type ether_addr; flags interval; }"
                nft add set bridge znetcontrol_pin dst_ok "{ type ether_addr; flags interval; elements = { $lan_mac, ff:ff:ff:ff:ff:ff, 01:00:5e:00:00:00/16, 33:33:00:00:00:00/16 } }"
                nft add chain bridge znetcontrol_pin forward "{ type filter hook forward priority -300; policy accept; }"
                nft add rule bridge znetcontrol_pin forward ether saddr @mac_ctl ether daddr != @dst_ok drop comment "pin-gateway"
                info "网关钉扎已启用（只允许发往 $lan_mac）"
            else
                info "未取到 br-lan MAC，跳过网关钉扎"
            fi
        fi
    fi
}

init_bypass_route() {
    info "初始化旁路由模式"
    
    if [ -n "$bin_nft" ]; then
        nft delete table inet znetcontrol 2>/dev/null || true
        
        nft add table inet znetcontrol
        
        nft add chain inet znetcontrol forward "{ type filter hook forward priority -100; policy accept; }"
        
        nft add chain inet znetcontrol input "{ type filter hook input priority -100; policy accept; }"
        
        info "旁路由nftables表已创建"
    fi
}

init_timecontrol() {
    detect_gateway_mode
    
    info "初始化时间控制（$GATEWAY_MODE 模式）"
    
    case "$GATEWAY_MODE" in
        "main")
            init_main_route
            ;;
        "bypass")
            init_bypass_route
            ;;
    esac
    
    info "初始化完成"
}

main_route_timeadd() {
    id=$1
    target=$2
    chain=$3
    value=$4
    display_name=$5

    # 【2.3.11 关键修复】多段规则并行
    # 历史做法把 MAC 塞进共享集合 mac_forward / mac_input，
    # 于是"同一设备配了工作日/周五/周末三段"时，任意一段执行 del
    # 都会按 MAC 值把元素整个删掉，把正在生效的其它段一起带走
    # （典型现象：日志说"在生效时间内"，集合却是空的，设备照常上网）。
    # 现在每段规则使用独立的 nft rule + 唯一 comment，按 comment
    # 精确增删，多段互不干扰。

    if ! is_valid_mac "$value"; then
        log "ERROR: 【$display_name】MAC 非法，拒绝写入 nft: [$value] (target=$target)"
        return 1
    fi

    _c_fwd="znc-r${id}-fwd"
    _c_in="znc-r${id}-in"

    # 幂等：先清掉本段自己的旧 rule，避免重复添加
    _del_rule_by_comment inet znetcontrol forward "$_c_fwd"
    _del_rule_by_comment inet znetcontrol input "$_c_in"

    # 出网路径：普通 / 强力两种模式都必须断
    if nft_run insert rule inet znetcontrol forward ether saddr "$value" counter drop comment "$_c_fwd"; then
        :
    else
        log "ERROR: 【$display_name】写入 forward 规则失败，MAC $value"
    fi
    # 网关钉扎集合（pin_gateway=1 时才有该表，不存在时静默）
    nft add element bridge znetcontrol_pin mac_ctl "{ $value }" 2>/dev/null

    if [ "$chain" = "input" ]; then
        # 强力控制：额外禁止访问路由器本身
        if nft_run insert rule inet znetcontrol input ether saddr "$value" counter drop comment "$_c_in"; then
            :
        else
            log "ERROR: 【$display_name】写入 input 规则失败，MAC $value"
        fi
        info "✅ 【$display_name】主路由-强力控制：MAC $value（断外网 + 断访问路由器，comment=$_c_fwd/$_c_in）"
    else
        info "✅ 【$display_name】主路由-普通控制：MAC $value（仅断外网，comment=$_c_fwd）"
    fi
    return 0
}

# 按 comment 精确删除某条规则（不按值删，避免误伤其它段）
_del_rule_by_comment() {
    _fam=$1; _tab=$2; _ch=$3; _cm=$4
    _h=$(nft -a list chain "$_fam" "$_tab" "$_ch" 2>/dev/null \
         | grep -F "comment \"$_cm\"" | sed -n 's/.*# handle \([0-9]*\).*/\1/p' | head -1)
    [ -n "$_h" ] || return 0
    nft_run delete rule "$_fam" "$_tab" "$_ch" handle "$_h"
}

# 该 MAC 是否还有其它"当前生效"的段（删除前的保底检查）
_mac_has_other_active_rule() {
    _id=$1; _mac=$2; _i=0
    while [ "$_i" -lt 300 ]; do
        _en=$(uci -q get "znetcontrol.@device[$_i].enable")
        _tg=$(uci -q get "znetcontrol.@device[$_i].target")
        [ -n "$_en" ] || [ -n "$_tg" ] || break
        if [ "$_i" != "$_id" ] && [ "$_en" = "1" ]; then
            _tg_l=$(echo "$_tg" | tr '[:upper:]' '[:lower:]')
            if [ "$_tg_l" = "$_mac" ] && check_list "$_i"; then
                return 0
            fi
        fi
        _i=$((_i + 1))
    done
    return 1
}

bypass_route_timeadd() {
    id=$1
    target=$2
    chain=$3
    value=$4
    display_name=$5
    
    info "🎯 【$display_name】旁路由规则添加"
    device_ip=$(get_device_ip "$value")
    
    # 清理显示名称中的特殊字符
    safe_name=$(echo "$display_name" | sed 's/[^a-zA-Z0-9_-]/_/g' | cut -c1-20)
    
    if [ "$chain" = "input" ]; then
        # 强力控制：同时限制访问路由器和外网
        
        # 1. 添加input链规则（限制访问路由器）
        nft add rule inet znetcontrol input ether saddr "$value" drop comment "$safe_name-input"
        nft add rule inet znetcontrol input ether saddr "$value" log prefix "ZNET-INPUT: " level info
        
        # 2. 添加forward链规则（限制访问外网）
        nft add rule inet znetcontrol forward ether saddr "$value" drop comment "$safe_name-forward"
        nft add rule inet znetcontrol forward ether saddr "$value" log prefix "ZNET-FORWARD: " level info
        
        # 3. 如果获取到IP地址，也添加IP规则
        if [ -n "$device_ip" ]; then
            nft add rule inet znetcontrol input ip saddr "$device_ip" drop
            nft add rule inet znetcontrol forward ip saddr "$device_ip" drop
            info "✅ 【$display_name】旁路由-强力控制：MAC+IP（内外网全限制）"
        else
            info "✅ 【$display_name】旁路由-强力控制：MAC（内外网全限制）"
        fi
    else
        # 普通控制：只限制访问外网
        nft add rule inet znetcontrol forward ether saddr "$value" drop comment "$safe_name-forward"
        nft add rule inet znetcontrol forward ether saddr "$value" log prefix "ZNET-FORWARD: " level info
        nft add rule inet znetcontrol forward ether saddr "$value" counter
        
        if [ -n "$device_ip" ]; then
            nft add rule inet znetcontrol forward ip saddr "$device_ip" drop
            nft add rule inet znetcontrol forward ip saddr "$device_ip" log prefix "ZNET-IP: " level info
            info "✅ 【$display_name】旁路由-普通控制：MAC+IP"
        else
            info "✅ 【$display_name】旁路由-普通控制：MAC"
        fi
    fi
}

timeadd() {
    id=$1
    target=$(config_t_get device target "$id")
    chain=$(config_t_get device chain "$id" "forward")
    [ -z "$target" ] && return
    
    if [ -z "$GATEWAY_MODE" ]; then
        detect_gateway_mode
    fi
    display_name=$(get_rule_display_name "$id")
    info "添加设备控制: 【$display_name】($target)，模式: $GATEWAY_MODE"
    parsed_result=$(parse_target "$target")
    if [ $? -ne 0 ]; then
        dbg "无法解析目标地址: $target"
        return
    fi
    
    type=$(echo "$parsed_result" | sed -n '1p')
    subtype=$(echo "$parsed_result" | sed -n '2p')
    value=$(echo "$parsed_result" | sed -n '3p')
    
    case "$type" in
        "mac")
            value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
            
            case "$GATEWAY_MODE" in
                "main")
                    main_route_timeadd "$id" "$target" "$chain" "$value" "$display_name"
                    ;;
                "bypass")
                    bypass_route_timeadd "$id" "$target" "$chain" "$value" "$display_name"
                    ;;
            esac
            ;;
            
        "ipv4")
            if [ "$GATEWAY_MODE" = "main" ]; then
                # 两种模式都先断外网
                nft_run add element inet znetcontrol ip_forward "{ $value }"
                if [ "$chain" = "input" ]; then
                    # 强力控制：额外禁止访问路由器本身
                    nft_run add element inet znetcontrol ip_input "{ $value }"
                    info "✅ 【$display_name】主路由-IP强力控制：$value（断外网 + 断访问路由器）"
                else
                    info "✅ 【$display_name】主路由-IP普通控制：$value（仅断外网）"
                fi
            else
                nft add rule inet znetcontrol forward ip saddr "$value" drop comment "$display_name-ip"
                info "✅ 【$display_name】旁路由-IP控制：$value"
            fi
            ;;
    esac
    
    # 立即断开已有连接，确保管控规则马上生效
    flush_connections "$target"
    
    # 同步源 IP 双保险集合
    sync_mac_ip_sets
}

timedel() {
    id=$1
    target=$(config_t_get device target "$id")
    name=$(config_t_get device name "$id")
    chain=$(config_t_get device chain "$id" "forward")
    [ -z "$target" ] && return
    
    # 【修复】确保 GATEWAY_MODE 已检测，否则会走错删除分支
    if [ -z "$GATEWAY_MODE" ]; then
        detect_gateway_mode
    fi
    display_name=$(get_rule_display_name "$id")
    parsed_result=$(parse_target "$target")
    if [ $? -ne 0 ]; then
        dbg "无法解析目标地址: $target"
        return
    fi
    
    type=$(echo "$parsed_result" | sed -n '1p')
    subtype=$(echo "$parsed_result" | sed -n '2p')
    value=$(echo "$parsed_result" | sed -n '3p')
    
    if [ -n "$bin_nft" ]; then
        case "$type" in
            "mac")
                value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
                
                if [ "$GATEWAY_MODE" = "main" ]; then
                    # 【2.3.11】只删本段自己的 rule（按 comment），
                    # 并保底检查：同一 MAC 若还有其它段处于生效期，则不动公共集合
                    _del_rule_by_comment inet znetcontrol forward "znc-r${id}-fwd"
                    _del_rule_by_comment inet znetcontrol input "znc-r${id}-in"
                    # 兼容旧版残留：共享集合里的元素只有确认无其它生效段时才清
                    if ! _mac_has_other_active_rule "$id" "$value"; then
                        nft delete element inet znetcontrol mac_forward "{ $value }" 2>/dev/null || true
                        nft delete element inet znetcontrol mac_input "{ $value }" 2>/dev/null || true
                        nft delete element bridge znetcontrol_pin mac_ctl "{ $value }" 2>/dev/null || true
                    else
                        dbg "【$display_name】MAC $value 仍有其它生效段，跳过共享集合清理"
                    fi
                    info "✅ 【$display_name】从防火墙移除: MAC $value（comment=znc-r${id}-fwd）"
                else
                    # 删除MAC地址规则
                    nft delete rule inet znetcontrol forward handle $(nft -a list chain inet znetcontrol forward 2>/dev/null | grep "ether saddr $value" | awk '{print $NF}' | head -1) 2>/dev/null || true
                    nft delete rule inet znetcontrol input handle $(nft -a list chain inet znetcontrol input 2>/dev/null | grep "ether saddr $value" | awk '{print $NF}' | head -1) 2>/dev/null || true
                    
                    # 删除对应的IP地址规则（如果有）
    device_ip=$(get_device_ip "$value")
                    if [ -n "$device_ip" ]; then
                        nft delete rule inet znetcontrol input handle $(nft -a list chain inet znetcontrol input 2>/dev/null | grep "ip saddr $device_ip" | awk '{print $NF}' | head -1) 2>/dev/null || true
                        nft delete rule inet znetcontrol forward handle $(nft -a list chain inet znetcontrol forward 2>/dev/null | grep "ip saddr $device_ip" | awk '{print $NF}' | head -1) 2>/dev/null || true
                        info "✅ 【$display_name】从防火墙移除: MAC $value 和 IP $device_ip"
                    else
                        info "✅ 【$display_name】从防火墙移除: $value"
                    fi
                fi
                ;;
            "ipv4")
                if [ "$GATEWAY_MODE" = "main" ]; then
                    nft delete element inet znetcontrol ip_forward "{ $value }" 2>/dev/null || true
                    nft delete element inet znetcontrol ip_input "{ $value }" 2>/dev/null || true
                else
                    # 删除IPv4地址规则（input和forward链）
                    nft delete rule inet znetcontrol forward handle $(nft -a list chain inet znetcontrol forward 2>/dev/null | grep "ip saddr $value" | awk '{print $NF}' | head -1) 2>/dev/null || true
                    nft delete rule inet znetcontrol input handle $(nft -a list chain inet znetcontrol input 2>/dev/null | grep "ip saddr $value" | awk '{print $NF}' | head -1) 2>/dev/null || true
                fi
                info "✅ 【$display_name】从防火墙移除: $value"
                ;;
        esac
    fi
    
    # 同步源 IP 双保险集合
    sync_mac_ip_sets
}

show_status() {
    echo ""
    echo "┌────────────────────────────────────────────┐"
    echo "│           ZNetControl 系统状态             │"
    echo "├────────────────────────────────────────────┤"
    
    if [ -z "$GATEWAY_MODE" ]; then
        detect_gateway_mode
    fi
    
    if [ "$GATEWAY_MODE" = "bypass" ]; then
        echo "│    运行模式: 旁路由模式                    │"
        echo "│    网关: ${BYPASS_GATEWAY:-未知}          │"
    else
        echo "│    运行模式: 主路由模式                    │"
    fi
    echo "├────────────────────────────────────────────┤"
   
    echo "│ 当前时间: $(date '+%Y-%m-%d %H:%M:%S')       │"
    
    case $(date '+%u') in
        1) weekday="星期一" ;;
        2) weekday="星期二" ;;
        3) weekday="星期三" ;;
        4) weekday="星期四" ;;
        5) weekday="星期五" ;;
        6) weekday="星期六" ;;
        7) weekday="星期日" ;;
        *) weekday="未知" ;;
    esac
    echo "│ 星期: $weekday                               │"
    echo "├────────────────────────────────────────────┤"
    
    # 修复配置规则数统计
    config_count=0
    if [ -f "/etc/config/znetcontrol" ]; then
        config_count=$(uci show znetcontrol 2>/dev/null | grep -c '^znetcontrol\.' || echo 0)
    fi
    
    # 修复生效规则数统计
    active_count=0
    if [ -f "$IDLIST" ] && [ -s "$IDLIST" ]; then
        active_count=$(tr -cd '!' < "$IDLIST" 2>/dev/null | wc -c || echo 0)
        # 或者使用：active_count=$(grep -o '!' "$IDLIST" 2>/dev/null | wc -l || echo 0)
    fi
    
    echo "│ 配置规则数: $config_count 个                 │"
    echo "│ 生效规则数: $active_count 个                 │"
    
    if [ "$active_count" -gt 0 ]; then
        echo "├────────────────────────────────────────────┤"
        echo "│ 当前控制中的设备:                          │"
        
        tr '!' '\n' < "$IDLIST" 2>/dev/null | grep -v '^$' | while read id; do
            if [ -n "$id" ]; then
    name=$(config_t_get device name "$id" 2>/dev/null || echo "规则$id")
    target=$(config_t_get device target "$id" 2>/dev/null || echo "未知")
    chain=$(config_t_get device chain "$id" 2>/dev/null || echo "forward")
                
                # 简化显示，确保不会超出边界
                name=$(echo "$name" | cut -c1-10)
                target=$(echo "$target" | cut -c1-13)
                
                if [ "$chain" = "input" ]; then
                    printf "│   🔒 %-10s - %-13s      │\n" "$name" "$target"
                else
                    printf "│   🔗 %-10s - %-13s      │\n" "$name" "$target"
                fi
            fi
        done
    fi
    
    echo "├────────────────────────────────────────────┤"
    echo "│ nftables状态:                              │"
    
    if [ "$GATEWAY_MODE" = "bypass" ]; then
        # 修复规则数统计
    rule_count=0
        if nft list table inet znetcontrol 2>/dev/null >/dev/null; then
            rule_count=$(nft list table inet znetcontrol 2>/dev/null | grep -c "drop comment" || echo 0)
        fi
        echo "│   规则数: $rule_count 条                          │"
    else
    inet_count=0
    mac_count=0
        if nft list table inet znetcontrol 2>/dev/null >/dev/null; then
            inet_count=$(nft list table inet znetcontrol 2>/dev/null | grep -c "drop comment" || echo 0)
        fi
        mac_count=$(nft list set inet znetcontrol mac_forward 2>/dev/null | grep -oE "[0-9a-f]{2}(:[0-9a-f]{2}){5}" | sort -u | wc -l)
        echo "│   阻断规则: $inet_count 条                        │"
        echo "│   受控终端: $mac_count 个                          │"
    fi
    
    echo "└────────────────────────────────────────────┘"
    echo ""
}

# ========== 修复：stop_timecontrol 确保 GATEWAY_MODE 已检测 ==========
stop_timecontrol() {
    info "停止时间控制服务"
    
    # 【修复】确保 GATEWAY_MODE 已检测，否则删除表时会走错分支导致残留
    if [ -z "$GATEWAY_MODE" ]; then
        detect_gateway_mode
    fi
    
    # 先停止监控进程
    if [ -f "/var/run/znetcontrol.pid" ]; then
    pid=$(cat /var/run/znetcontrol.pid 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null
            sleep 1
            kill -KILL "$pid" 2>/dev/null 2>&1
        fi
    fi
    
    # 清理防火墙规则（添加超时）
    if [ -n "$bin_nft" ]; then
    timeout=5
        timeout nft delete table bridge znetcontrol_pin 2>/dev/null || true
        if [ "$GATEWAY_MODE" = "main" ]; then
            timeout nft delete table ip znetcontrol 2>/dev/null && info "已清理IPv4表"
            timeout nft delete table ip6 znetcontrol 2>/dev/null && info "已清理IPv6表"
            timeout nft delete table bridge znetcontrol 2>/dev/null && info "已清理bridge表"
        else
            timeout nft delete table inet znetcontrol 2>/dev/null && info "已清理inet表"
        fi
    fi
    
    # 清理文件
    rm -rf "$IDLIST" "$TMPID" /var/run/znetcontrol.pid 2>/dev/null
    info "所有规则已清除"
}

show_help() {
    echo "ZNetControl 上网时间控制系统"
    echo ""
    echo "支持的地址格式:"
    echo "  1. 单个IP: 192.168.1.100"
    echo "  2. IP范围: 192.168.1.1-192.168.1.100"
    echo "  3. CIDR: 192.168.1.0/24"
    echo "  4. MAC地址: 00:11:22:33:44:55"
    echo ""
    echo "用法: $0 {start|stop|add <id>|del <id>|check <id>|sync|status|help}"
    echo ""
    echo "配置: 编辑 /etc/config/znetcontrol"
    echo "日志: 查看 /var/log/znetcontrol.log"
}

if [ -x "$bin_nft" ]; then
    nftables_ver="true"
    dbg "nft found: $bin_nft"
elif [ -x "$bin_iptables" ] || [ -x "$bin_ip6tables" ]; then
    iptables_ver="true"
    dbg "iptables found: $bin_iptables"
else
    dbg "No firewall tool found!"
    exit 1
fi

CHAIN=$(uci -q get znetcontrol.settings.chain || echo "forward")
list_type=$(uci -q get znetcontrol.settings.control_mode || echo "blacklist")

case "$crrun" in
    "start")
        stop_timecontrol
        echo -e "\n====== 启动 ZNetControl ======" >> "$LOG_FILE"
        mkdir -p /var/log /var/run 2>/dev/null
        touch "$IDLIST" 2>/dev/null
        
        # ===== 硬件卸载控制 =====
        # 【修复】此处原本在顶层用了 local，bash 会报
        # "local: can only be used in a function" 并让变量取不到值，
        # 导致"关闭流量卸载"整段从不执行 —— 已卸载的连接会绕过
        # forward 钩子，被控终端照样能上网。改为普通变量。
        offload_control=$(config_s_get offload_control "1")
        hw_control=$(config_s_get hw_offload_control "0")
        if [ "$offload_control" = "1" ] || [ "$hw_control" = "1" ]; then
            sw_enabled=$(uci -q get firewall.@defaults[0].flow_offloading)
            hw_enabled=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
            if [ "$sw_enabled" = "1" ] || [ "$hw_enabled" = "1" ]; then
                # 保存原始状态
                uci set znetcontrol.settings.offload_backup="1"
                uci set znetcontrol.settings.sw_offload_backup="$sw_enabled"
                uci set znetcontrol.settings.hw_offload_backup="$hw_enabled"
                uci commit znetcontrol
                # 关闭软件 + 硬件卸载
                uci set firewall.@defaults[0].flow_offloading='0'
                uci set firewall.@defaults[0].flow_offloading_hw='0'
                uci commit firewall
                fw4 reload 2>/dev/null || true
                info "流量卸载已关闭（软件:$sw_enabled 硬件:$hw_enabled）"
            fi
        fi
        # ===== 结束 =====
        
        info "从配置文件加载规则..."
        
        enabled_ids=$(get_enabled_rule_ids)
        info "发现启用规则: $(echo $enabled_ids | wc -w) 个"
        
        init_timecontrol
        
        # ===== 【2.3.11-fix】只清理非法残留，不清空合法元素 =====
        # 上一版这里用 nft flush set 清空 mac_forward/mac_input，
        # 实测副作用：集合被清空后，本应引用它们的保底规则
        # block-mac-forward / block-mac-input 没能建立（add rule 报
        # "does not exist"），结果集合与规则同时失效，被控设备完全不受控。
        # 正确做法：保底规则继续引用共享集合，这里只删全零等非法元素。
        #   - 合法 MAC 保留（兜底不遗漏）
        #   - 每段独立 rule（comment=znc-r<id>-fwd/in）负责多段并行精确增删
        for _s in mac_forward mac_input; do
            nft delete element inet znetcontrol "$_s" "{ 00:00:00:00:00:00 }" 2>/dev/null || true
        done
        info "已清理非法集合元素（全零 MAC），保底规则保持不变"
        # ===== 结束 =====

        # ===== 清理禁用规则的残留 =====
        all_index=0
        while true; do
            en=$(uci -q get "znetcontrol.@device[$all_index].enable")
            tg=$(uci -q get "znetcontrol.@device[$all_index].target")
            [ -z "$en" ] && [ -z "$tg" ] && break
            
            if [ "$en" != "1" ] && [ -n "$tg" ]; then
                # 禁用规则，强制从 nftables 删除残留
                timedel "$all_index"
                info "清理禁用规则残留: ID=$all_index"
            fi
            all_index=$((all_index + 1))
        done
        # ===== 结束 =====
        
        if [ -n "$enabled_ids" ]; then
            for id in $enabled_ids; do
                display_name=$(get_rule_display_name "$id")
                info "处理【$display_name】"
                
                if check_list "$id"; then
                    timeadd "$id"
                    echo "!${id}!" >> "$IDLIST"
                    info "✅ 【$display_name】已添加到控制列表"
                else
                    info "⏰ 【$display_name】不在生效时间"
                fi
            done
        else
            info "⚠️ 没有找到启用规则"
        fi
        
        info "时间控制启动完成，控制 $(wc -l < "$IDLIST" 2>/dev/null || echo 0) 个设备"
        show_status
        ;;
        
    "stop")
        # ===== 恢复硬件卸载 =====
        backed_up=$(uci -q get znetcontrol.settings.offload_backup)
        if [ "$backed_up" = "1" ]; then
            sw_bak=$(uci -q get znetcontrol.settings.sw_offload_backup)
            hw_bak=$(uci -q get znetcontrol.settings.hw_offload_backup)
            [ -n "$sw_bak" ] && uci set firewall.@defaults[0].flow_offloading="$sw_bak"
            [ -n "$hw_bak" ] && uci set firewall.@defaults[0].flow_offloading_hw="$hw_bak"
            uci commit firewall
            fw4 reload 2>/dev/null || true
            uci delete znetcontrol.settings.offload_backup >/dev/null 2>&1
            uci delete znetcontrol.settings.sw_offload_backup >/dev/null 2>&1
            uci delete znetcontrol.settings.hw_offload_backup >/dev/null 2>&1
            uci commit znetcontrol
            info "流量卸载已恢复"
        fi
        # ===== 结束 =====
        info "停止时间控制服务"
        stop_timecontrol
        info "所有防火墙规则已清除"
        ;;
        
    "add")
        info "添加设备控制"
        for list in $(echo "$crid" | sed -e 's/!//g' | sed 's/,/ /g'); do
            display_name=$(get_rule_display_name "$list")
            
            if check_list "$list"; then
                timeadd "$list"
                if ! grep -q "!$list!" "$IDLIST"; then
                    echo "!$list!" >> "$IDLIST"
                fi
                info "【$display_name】已添加"
            else
                if grep -q "!${list}!" "$IDLIST"; then
                    timedel "$list"
                    sed -i "/!$list!/d" "$IDLIST"
                    info "【$display_name】已移除"
                fi
            fi
        done
        ;;
        
    "del")
        info "移除设备控制"
        for list in $(echo "$crid" | sed -e 's/!//g' | sed 's/,/ /g'); do
            display_name=$(get_rule_display_name "$list")
            
            timedel "$list"
            sed -i "/!$list!/d" "$IDLIST"
            info "【$display_name】已删除"
        done
        ;;
        
    "check")
        # 【2.3.11】唯一时间判定入口：start 与 ctrl 共用
        # 退出码 0 = 该段当前处于生效期；1 = 不在生效期
        id=$(echo "$crid" | sed -e 's/!//g' | cut -d, -f1)
        [ -z "$id" ] && exit 1
        en=$(config_t_get device enable "$id")
        [ "$en" = "1" ] || exit 1
        if check_list "$id"; then
            exit 0
        fi
        exit 1
        ;;

    "sync")
        # 同步派生IP集合（由 znetcontrolctrl 定时调用）
        if [ -z "$GATEWAY_MODE" ]; then
            detect_gateway_mode
        fi
        sync_mac_ip_sets
        ;;
    
    "status")
        show_status
        ;;
        
    "help"|"")
        show_help
        ;;
        
    *)
        dbg "无效命令: $crrun"
        show_help
        exit 1
        ;;
esac
