#!/bin/sh

NAME=znetcontrol
IDLIST="/var/run/$NAME.idlist"
TMPID="/var/run/$NAME.tmpid"

get_rule_name() {
    id=$1
    name=$(uci -q get znetcontrol.@device[$id].name)
    if [ -z "$name" ] || [ "$name" = "新规则" ]; then
        name=$(uci -q get znetcontrol.@device[$id].target)
        if [ -z "$name" ]; then
            name="规则$id"
        fi
    fi
    echo "$name"
}

get_enabled_rule_ids() {
    rule_ids=""
    index=0
    
    while true; do
    enable_val=$(uci -q get "znetcontrol.@device[$index].enable")
    target_val=$(uci -q get "znetcontrol.@device[$index].target")
        
        if [ -z "$enable_val" ] && [ -z "$target_val" ]; then
            break
        fi
        
        if [ "$enable_val" = "1" ] && [ -n "$target_val" ]; then
            rule_ids="$rule_ids $index"
        fi
        
        index=$((index + 1))
    done
    
    echo $rule_ids
}

config_t_get() {
    section=$1
    option=$2
    index=$3
    
    value=$(uci -q get "znetcontrol.@${section}[${index}].${option}")
    echo "$value"
}

# 使用数值计算的时间判断函数
is_time_in_range() {
    start_time=$1
    end_time=$2
    
    # 处理空值
    start_time=${start_time:-00:00}
    end_time=${end_time:-23:59}
    
    # 获取当前时间
    current_hour=$(date +%H)
    current_minute=$(date +%M)
    current_total=$(($current_hour * 60 + $current_minute))
    
    # 转换开始时间
    start_hour=${start_time%:*}
    start_minute=${start_time#*:}
    start_total=$(($start_hour * 60 + $start_minute))
    
    # 转换结束时间
    end_hour=${end_time%:*}
    end_minute=${end_time#*:}
    end_total=$(($end_hour * 60 + $end_minute))
    
    # 如果是全天
    if [ "$start_time" = "$end_time" ]; then
        return 0  # 全天生效
    elif [ $start_total -lt $end_total ]; then
        # 正常时间段（不跨天）
        # 包含开始时间，不包含结束时间
        [ $current_total -ge $start_total ] && [ $current_total -lt $end_total ] && return 0
    else
        # 跨天时间段
        [ $current_total -ge $start_total ] || [ $current_total -lt $end_total ] && return 0
    fi
    
    return 1
}

is_weekday_in_range() {
    configured_weekdays=$1
    current_weekday=$(date +%u)  # 1=星期一, 7=星期日
    
    # 如果配置为"0"，表示每天
    [ "$configured_weekdays" = "0" ] && return 0
    [ -z "$configured_weekdays" ] && return 0
    
    # 把逗号替换成空格，逐项处理
    parts=$(echo "$configured_weekdays" | tr ',' ' ')
    
    for part in $parts; do
        part=$(echo "$part" | tr -d ' ')
        [ -z "$part" ] && continue
        
        # 范围格式：1-5
        if echo "$part" | grep -qE '^[0-9]+-[0-9]+$'; then
    start=$(echo "$part" | cut -d'-' -f1)
    end=$(echo "$part" | cut -d'-' -f2)
            if [ -n "$start" ] && [ -n "$end" ] && \
               [ "$start" -ge 1 ] && [ "$end" -le 7 ] && [ "$start" -le "$end" ]; then
                if [ "$current_weekday" -ge "$start" ] && [ "$current_weekday" -le "$end" ]; then
                    return 0
                fi
            fi
        else
            # 单个数字格式：3 或 1,2,3,4,5
            if [ "$current_weekday" = "$part" ]; then
                return 0
            fi
        fi
    done
    
    return 1
}

check_device() {
    id=$1
    enable_val=$(config_t_get device enable $id)

    # 检查是否启用
    [ "$enable_val" != "1" ] && return 1

    # 【2.3.11】时间/星期判定唯一入口：委托给 znetcontrol check
    # 历史问题: ctrl 用自己的 is_weekday_in_range，而 start 用 check_list
    # （其 awk 在 BEGIN 里比较 $0 空串，星期恒通过），两套判定分叉，
    # 导致 start 把所有段都加入、ctrl 随即按自己的判定删掉不生效的段，
    # 而 del 是按 MAC 值删元素，会把其它正在生效的段一并删掉。
    if /usr/bin/znetcontrol check "$id" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

update_device_status() {
    id=$1
    action=$2
    
    rule_name=$(get_rule_name $id)
    
    if [ "$action" = "add" ]; then
        znetcontrol add $id
        echo "!${id}!" >> $IDLIST
        logger -t znetcontrol "【$rule_name】已添加到防火墙"
    elif [ "$action" = "del" ]; then
        znetcontrol del $id
        sed -i "/!$id!/d" $IDLIST >/dev/null 2>&1
        logger -t znetcontrol "【$rule_name】已从防火墙移除"
    fi
}

process_devices() {
    [ -s $IDLIST ] || touch $IDLIST
    
    log "开始检查设备规则..."
    
    # 获取当前启用的规则ID
    enabled_ids=$(get_enabled_rule_ids)
    
    for id in $enabled_ids; do
    rule_name=$(get_rule_name $id)
        
        if check_device $id; then
            log "【$rule_name】在生效时间内"
            if ! grep -q "!${id}!" $IDLIST; then
                log "添加【$rule_name】到防火墙"
                update_device_status $id "add"
            fi
        else
            log "【$rule_name】不在生效时间内"
            if grep -q "!${id}!" $IDLIST; then
                log "从防火墙移除【$rule_name】"
                update_device_status $id "del"
            fi
        fi
    done

    # 清理并排序ID列表
    cat $IDLIST 2>/dev/null | sort | uniq > $TMPID 2>/dev/null
    [ -f $TMPID ] && mv $TMPID $IDLIST 2>/dev/null
    
    log "当前防火墙中的规则: $(cat $IDLIST 2>/dev/null | wc -l) 个"
}

log() {
    d="$(date '+%Y-%m-%d %H:%M:%S')"
    echo "[$d] INFO: $@" >>/var/log/znetcontrol.log
}

while :; do
    process_devices
    # 同步"由 MAC 规则派生出的终端 IP"集合
    # 终端 IP 可能变化（续租/静态改配），需周期性刷新双保险规则
    znetcontrol sync >/dev/null 2>&1
    sleep 30
done
