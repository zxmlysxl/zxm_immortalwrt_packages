#!/bin/sh /etc/rc.common
# ZNetControl init.d  (纯 ash 兼容, 无 bashism, 结尾无 exit 0)
# 同时管理:
#   1) nftables 管控规则服务（znetcontrolctrl 30s watch loop）
#   2) 定时任务（/etc/crontabs/root 内标记块 #znc-sched-begin .. #znc-sched-end）
#
# 定时任务设计目标（比 taskplan 可靠）:
#   - cron 行写入 /etc/crontabs/root 持久文件, 重启不丢
#   - uci commit 后由 ucitrack 触发 reload, 自动重生成 cron 块
#   - boot 时兜底重生成一次
#   - 标记块用 awk 精确定位, 不影响用户其它 crontab 行
#   - 写完后必须显式让 crond 重读（见 cron_reload）

START=99
STOP=10
USE_PROCD=1

NAME=znetcontrol
PROG=/usr/bin/znetcontrolctrl
PIDFILE="/var/run/${NAME}.pid"
LOGFILE="/var/log/${NAME}.log"
RUNDIR="/var/run/znetcontrol"
CRONDIR=/etc/crontabs
CRON="$CRONDIR/root"
CRONUSER=root
ZBEGIN="#znc-sched-begin"
ZEND="#znc-sched-end"

# 显式 PATH: LuCI/ubus 拉起 init.d 时 PATH 极简, 会找不到 /usr/sbin/nft 等工具
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $@" >> "$LOGFILE"
}

# ---------- crond 进程是否在跑 ----------
crond_running() {
    if command -v pidof >/dev/null 2>&1; then
        pidof crond >/dev/null 2>&1 && return 0
    fi
    if command -v pgrep >/dev/null 2>&1; then
        pgrep crond >/dev/null 2>&1 && return 0
    fi
    for p in /proc/[0-9]*; do
        [ -r "$p/comm" ] || continue
        c=$(cat "$p/comm" 2>/dev/null)
        [ "$c" = "crond" ] && return 0
    done
    return 1
}

# ---------- 让 crond 立刻重读 crontab ----------
cron_reload() {
    # busybox crond 官方重载钩子: 在 crontab 目录写 cron.update（内容=用户名）
    # crond 每分钟检查一次, 命中后立刻重新载入该用户的 crontab
    echo "$CRONUSER" > "$CRONDIR/cron.update" 2>/dev/null
    # 官方 cron init 没有 reload 动作, rc.common 会把 reload 退化成 start,
    # 而 procd 的 set 不保证真重启 crond -> 用 restart 强制全量重读
    # (restart = stop+start, crond 启动时 rescan_crontab_dir() 重新载入所有 crontab)
    /etc/init.d/cron restart >/dev/null 2>&1
    # crond 没在跑就拉起来
    if ! crond_running; then
        /etc/init.d/cron enable >/dev/null 2>&1
        /etc/init.d/cron start >/dev/null 2>&1
        log "cron: crond 未运行, 已 enable+start /etc/init.d/cron"
    fi
    # 开机自启: 否则重启后 crond 不在, 定时任务永远不触发
    /etc/init.d/cron enable >/dev/null 2>&1
    if crond_running; then
        log "cron: crond 运行中"
    else
        log "cron: 警告 crond 仍未运行, 定时任务不会触发, 请检查 /etc/init.d/cron"
    fi
}

# ---------- 定时任务 cron 块生成 ----------
sched_write() {
    [ -d /etc/taskplan ] || mkdir -p /etc/taskplan
    [ -d "$CRONDIR" ] || mkdir -p "$CRONDIR"
    [ -f "$CRON" ] || : > "$CRON"

    # 自定义脚本从 UCI 落地
    if [ "$(uci -q get znetcontrol.settings.customscript | wc -l)" -gt 0 ] 2>/dev/null; then
        uci -q get znetcontrol.settings.customscript > /etc/taskplan/znc-custom-script 2>/dev/null
        sed -i 's/\r$//' /etc/taskplan/znc-custom-script 2>/dev/null
        chmod 755 /etc/taskplan/znc-custom-script 2>/dev/null
    fi

    # 先摘掉旧块（awk 原地重定向, 保留用户自己的其它 crontab 行）
    awk -v b="$ZBEGIN" -v e="$ZEND" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        skip != 1 { print }
    ' "$CRON" > "/tmp/znc-cron.tmp" 2>/dev/null

    # 收集启用的 stime 任务, 一次性写标记块
    {
        echo "$ZBEGIN"
        ssum=$(grep -c 'config stime' /etc/config/znetcontrol 2>/dev/null || echo 0)
        [ "$ssum" -gt 0 ] 2>/dev/null || ssum=0
        for i in $(seq 0 $((ssum - 1))); do
            en=$(uci -q get "znetcontrol.@stime[${i}].enable" 2>/dev/null)
            [ "$en" = "1" ] || continue
            mt=$(uci -q get "znetcontrol.@stime[${i}].minute" 2>/dev/null); [ -n "$mt" ] || mt="0"
            hr=$(uci -q get "znetcontrol.@stime[${i}].hour" 2>/dev/null);  [ -n "$hr" ] || hr="0"
            mo=$(uci -q get "znetcontrol.@stime[${i}].month" 2>/dev/null); [ -n "$mo" ] || mo="*"
            wk=$(uci -q get "znetcontrol.@stime[${i}].week" 2>/dev/null);  [ -n "$wk" ] || wk="*"
            # UI 语义: 0 = 每天; cron 语义: dow=0 表示周日, 每天必须用 *
            # 不做转换的话, 选"0=每天"实际只在周日执行
            [ "$wk" = "0" ] && wk="*"
            styp=$(uci -q get "znetcontrol.@stime[${i}].stype" 2>/dev/null); [ -n "$styp" ] || styp="network"
            rmark=$(uci -q get "znetcontrol.@stime[${i}].remarks" 2>/dev/null)
            [ -n "$rmark" ] || rmark="task${i}"
            # 备注里的 # 会被 cron 当成注释起点, 双引号会破坏命令, 一律剔除
            rmark=$(printf '%s' "$rmark" | sed 's/[#"\]//g')
            [ -n "$rmark" ] || rmark="task${i}"
            echo "${mt} ${hr} * ${mo} ${wk} /usr/bin/znc-schedhandler ${styp} \"${rmark}\""
        done
        echo "$ZEND"
    } >> "/tmp/znc-cron.tmp"

    # 原地覆盖: 保留 inode, 只有 mtime 变化
    # （用 sed -i 换 inode 会让 procd 的 file 监视失效, crond 就再也读不到新内容）
    cat "/tmp/znc-cron.tmp" > "$CRON" 2>/dev/null
    rm -f "/tmp/znc-cron.tmp" 2>/dev/null

    # crontab 必须是 root 属主且不可被 group/other 写, 否则 cron 会拒绝加载
    chown root:root "$CRON" 2>/dev/null
    chmod 600 "$CRON" 2>/dev/null

    cron_reload
    log "sched_write: 重生成定时任务块, 启用任务数=$(grep -c 'znc-schedhandler' "$CRON" 2>/dev/null || echo 0), crond运行中=$(crond_running && echo 是 || echo 否)"
}

# ---------- nftables 规则服务 ----------
validate_service() {
    # 判断"是否存在启用的管控规则":
    #   uci show 输出的值带单引号(enable='1'), 用 grep 匹配容易踩引号坑;
    #   这里直接逐条读 UCI 计数, 纯 ash 可靠。
    # 注意: 设备段里有 enable="0" 的空规则是常态, 不能一遇到空就 break,
    #   否则前面全是禁用规则时会误判为"没有启用规则"; 上限 300 段防御死循环。
    # 另外 nft 用绝对路径定位, 不依赖 PATH(LuCI/ubus 拉起时 PATH 极简)
    _cnt=0
    _i=0
    while [ "$_i" -lt 300 ]; do
        _en=$(uci -q get "znetcontrol.@device[$_i].enable" 2>/dev/null)
        _tg=$(uci -q get "znetcontrol.@device[$_i].target" 2>/dev/null)
        [ -n "$_en" ] || [ -n "$_tg" ] || break
        [ "$_en" = "1" ] && _cnt=$((_cnt + 1))
        _i=$((_i + 1))
    done
    if [ "$_cnt" -eq 0 ] 2>/dev/null; then
        return 1
    fi
    for _p in /usr/sbin/nft /sbin/nft /usr/bin/nft /bin/nft; do
        [ -x "$_p" ] && return 0
    done
    command -v nft >/dev/null 2>&1 || return 1
    return 0
}

pre_start_cleanup() {
    tables=$(nft list tables 2>/dev/null | awk '{print $2}' 2>/dev/null)
    for t in $tables; do
        echo "$t" | grep -q "znetcontrol" && nft delete table "$t" 2>/dev/null || true
    done
    rm -rf "$RUNDIR" 2>/dev/null
    mkdir -p "$RUNDIR"
    if /usr/bin/znetcontrol start >/tmp/znetcontrol_start.log 2>&1; then
        return 0
    fi
    cat /tmp/znetcontrol_start.log 2>/dev/null || true
    log "pre_start_cleanup: /usr/bin/znetcontrol start 失败, 详见 /tmp/znetcontrol_start.log"
    return 1
}

post_stop_cleanup() {
    tables=$(nft list tables 2>/dev/null | awk '{print $2}' 2>/dev/null)
    for t in $tables; do
        echo "$t" | grep -q "znetcontrol" && nft delete table "$t" 2>/dev/null || true
    done
    rm -rf "$RUNDIR" 2>/dev/null
}

start_service() {
    # 定时任务块无条件写入, 不依赖 nftables 规则服务是否启用
    sched_write

    # 规则服务是可选增强: 无 nft / 无启用规则 / 清理失败时只跳过规则部分
    # 但 procd 实例必须无条件注册, 否则服务没有 instance, UCI 永远显示"已停止"
    if ! validate_service; then
        log "规则服务: 没有启用规则或 nft 缺失, 仅运行定时任务(服务仍为已启动)"
    elif ! pre_start_cleanup; then
        log "规则服务: 启动清理失败, 仅运行定时任务(服务仍为已启动)"
    fi

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn
    procd_set_param respawn_retry 3600
    procd_set_param env ZNETCONTROL_DEBUG=0
    procd_set_param env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    procd_set_param pidfile "$PIDFILE"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/znetcontrol
    procd_set_param user root
    procd_set_param group root
    procd_close_instance

    sleep 2
    # 只打日志, 不能影响退出码: 这里返回非 0 会让 rc.common 认为启动失败
    /usr/bin/znetcontrol status 2>/dev/null
    return 0
}

stop_service() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { kill -TERM "$pid" 2>/dev/null; sleep 2; }
    fi
    post_stop_cleanup
    pkill -f "znetcontrolctrl" 2>/dev/null
    sleep 1
    # 同上: stop 的返回值不能让 rc.common 判定为失败
    return 0
}

reload_service() {
    # UCI 变更统一入口: 先无条件重写 cron 块(不依赖规则服务), 再处理规则服务
    sched_write
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
        kill -HUP "$(cat "$PIDFILE")" 2>/dev/null
        /usr/bin/znetcontrol start >/dev/null 2>&1
        log "reload: 规则服务已重载, 定时任务块已重写"
        return 0
    fi
    log "reload: 规则进程不在(或无启用规则), 定时任务块已写入, 跳过规则服务"
    return 0
}

service_triggers() {
    procd_add_reload_trigger "znetcontrol"
}

# ---------- 入口 ----------
# 注意: 这里不能定义 start/stop/restart/reload, 否则会覆盖 rc.common 的实现。
# rc.common 在 USE_PROCD=1 时, 它的 start() 才会执行 procd_open_service/close_service;
# 一旦被覆盖成直接调 start_service, procd 就不会注册服务实例,
# /etc/init.d/znetcontrol status 永远 not running (2.3.8 的 BUG 根因之一)。
_zstart() {
    start_service
}

_zstop() {
    stop_service
}

_zrestart() {
    _zstop
    sleep 2
    _zstart
}

_zreload() {
    reload_service
}

boot() {
    # boot 阶段无论规则服务是否启用, 都要把定时任务写进 crontab
    # 必须走 rc.common 的 start (USE_PROCD 时内部会 procd_open_service/close_service),
    # 直接调 start_service 会漏掉 procd 服务注册, UCI 会显示"已停止"
    sched_write
    # rc.common 在 rc=procd 时, start() -> procd_start_service()
    #     -> procd_open_service(NAME) / start_service / procd_close_service
    # 这里等价地走一遍, 保证 procd 实例注册
    if type procd_open_service >/dev/null 2>&1; then
        procd_open_service "$NAME" "/etc/init.d/$NAME"
        start_service
        procd_close_service
    else
        start_service
    fi
}

boot_done() {
    # 兜底: 启动完成后若块缺失, 重写一次
    if [ -f "$CRON" ] && ! grep -q "^${ZBEGIN}" "$CRON" 2>/dev/null; then
        ssum=$(grep -c 'config stime' /etc/config/znetcontrol 2>/dev/null || echo 0)
        [ "$ssum" -gt 0 ] 2>/dev/null || ssum=0
        for i in $(seq 0 $((ssum - 1))); do
            [ "$i" -ge "$ssum" ] && break
            en=$(uci -q get "znetcontrol.@stime[${i}].enable" 2>/dev/null)
            [ "$en" = "1" ] && { log "boot_done: 检测到启用任务但块缺失, 重写"; sched_write; break; }
        done
    fi
}

